{
  "ConnectionStrings": {
    "Payments": "Host=localhost;Port=5434;Database=payx_payments;Username=payx_payments;Password=payx_payments_dev"
  },
  // Same token rules as the Gateway (Module 2.4).
  "Jwt": {
    "MetadataAddress": "http://localhost:7081/.well-known/openid-configuration",
    "Issuer": "payx-identity",
    "Audience": "payx-api"
  },
  "Vault": {
    "BaseUrl": "http://localhost:7084/",
    // Longer than Vault's own 10 s PSP timeout, so a slow PSP comes back as
    // Vault's explicit 504 psp_timeout rather than Payment giving up first.
    "Timeout": "00:00:15"
  },
  "Psp": {
    // The PSP simulator locally; the provider's API in production.
    "BaseUrl": "http://localhost:7088/",
    "Timeout": "00:00:10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
