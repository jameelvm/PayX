{
  "ConnectionStrings": {
    "Payments": "Host=localhost;Port=5434;Database=payx_payments;Username=payx_payments;Password=payx_payments_dev"
  },
  // Same token rules as the Gateway (Module 2.4).
  "Jwt": {
    "MetadataAddress": "http://localhost:7081/.well-known/openid-configuration",
    "Issuer": "payx-identity",
    "Audience": "payx-api"
  },
  "Vault": {
    "BaseUrl": "http://localhost:7084/",
    // Longer than Vault's own 10 s PSP timeout, so a slow PSP comes back as
    // Vault's explicit 504 psp_timeout rather than Payment giving up first.
    "Timeout": "00:00:15"
  },
  "Risk": {
    // Asked before every authorization (5.5).
    "BaseUrl": "http://localhost:7083/",
    // Scoring takes milliseconds; 2 s means something is wrong (5.6).
    "Timeout": "00:00:02",
    // Stop asking a failing Risk (5.7): at least 5 calls in 30 s, half of
    // them failed → open for 15 s, then one trial call.
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:15"
    },
    // When Risk can't answer (5.7): payments below these amounts (minor
    // units, about $100) go ahead unchecked; anything else waits for Risk.
    // A currency not listed always waits. Illustrative values.
    "Fallback": {
      "AllowBelowMinor": { "USD": 10000, "EUR": 10000, "GBP": 8000, "INR": 800000, "JPY": 15000 }
    }
  },
  "Kafka": {
    // The host listener; containers use kafka:9092 (docker-compose.yml).
    "BootstrapServers": "localhost:9094"
  },
  "Outbox": {
    // The relay (6.2): up to 100 events per pass; when idle, look again
    // every 0.5 s; after a failure (Kafka down) wait 5 s.
    "BatchSize": 100,
    "PollInterval": "00:00:00.500",
    "ErrorBackoff": "00:00:05"
  },
  "Payment": {
    // How long a claimed Idempotency-Key stays locked to its request (4.6).
    // Longer than any request takes; after it, a retry may take over.
    "IdempotencyLock": "00:00:30"
  },
  "Psp": {
    // The PSP simulator locally; the provider's API in production.
    "BaseUrl": "http://localhost:7088/",
    "Timeout": "00:00:10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
