{
  "ConnectionStrings": {
    // The service's own login (7.2): SELECT/INSERT on the journal, never
    // UPDATE or DELETE.
    "Ledger": "Host=localhost;Port=5434;Database=payx_ledger;Username=payx_ledger_app;Password=payx_ledger_app_dev",
    // The tables' owner: used only to run migrations at startup (local dev).
    "LedgerMigrations": "Host=localhost;Port=5434;Database=payx_ledger;Username=payx_ledger;Password=payx_ledger_dev"
  },
  "Kafka": {
    // The host listener; containers use kafka:9092 (docker-compose.yml).
    "BootstrapServers": "localhost:9094"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
