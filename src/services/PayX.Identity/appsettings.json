{
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5434;Database=payx_identity;Username=payx_identity;Password=payx_identity_dev"
  },
  "Jwt": {
    "Issuer": "payx-identity",
    "Audience": "payx-api",
    // Short-lived: a stolen token is useful for 15 minutes at most, because
    // a stateless token can't be revoked before it expires.
    "LifetimeMinutes": 15,
    // Gitignored; created on first start (see TokenIssuer).
    "SigningKeyPath": "../../../.keys/identity-signing-key.pem"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Shows each migration being applied, and the SQL it runs.
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  }
}
