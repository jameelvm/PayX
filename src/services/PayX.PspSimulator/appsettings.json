{
  "ConnectionStrings": {
    "Psp": "Host=localhost;Port=5434;Database=payx_psp;Username=payx_psp;Password=payx_psp_dev"
  },
  "Psp": {
    // Key for card fingerprints (HMAC). Dev-only value; a real provider keeps
    // it in a secrets store / HSM.
    "FingerprintKey": "payx-psp-dev-fingerprint-key"
  },
  "AWS": {
    // LocalStack. Remove on AWS: the SDK then uses the real endpoint and the
    // task role's credentials.
    "ServiceURL": "http://localhost:4568",
    "Region": "us-east-1",
    // LocalStack serves buckets at http://localhost:4568/<bucket>, not as
    // <bucket>.localhost subdomains.
    "ForcePathStyle": true
  },
  "Settlement": {
    // The end-of-day settlement file (8.1). A real PSP settles once a day;
    // locally a "day" is 2 minutes so files appear while you watch.
    // Use "1.00:00:00" for a real day.
    "Interval": "00:02:00",
    "Bucket": "payx-settlement-files",
    // The PSP's fee per charge: 2.9% + 30¢ (typical card pricing).
    "FeeBasisPoints": 290,
    "FeeFixedMinor": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  }
}
