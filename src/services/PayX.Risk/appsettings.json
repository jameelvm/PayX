{
  "ConnectionStrings": {
    // Velocity counters (5.2), under risk:* on the shared local instance.
    // abortConnect=false: start even if Redis is down, and keep retrying.
    "Redis": "localhost:6381,abortConnect=false"
  },
  "Risk": {
    // Risk policy (5.1). Illustrative values, roughly $1,000 / $5,000 per
    // currency, in that currency's minor units. A fraud team tunes these;
    // edits apply to the next request (IOptionsMonitor).
    "Rules": {
      "AmountBands": {
        "USD": { "ElevatedMinor": 100000, "HighMinor": 500000 },
        "EUR": { "ElevatedMinor": 100000, "HighMinor": 500000 },
        "GBP": { "ElevatedMinor": 80000, "HighMinor": 400000 },
        "INR": { "ElevatedMinor": 8000000, "HighMinor": 40000000 },
        "JPY": { "ElevatedMinor": 150000, "HighMinor": 750000 }
        // KWD left out on purpose: shows the amount_unrated rule.
      },
      "HomeCountry": "US",
      // XR: an ISO 3166 user-assigned code, so no real country is labelled.
      "HighRiskCountries": [ "XR" ],
      // Payments per customer in a sliding window (5.2), this one included.
      "Velocity": { "Window": "00:10:00", "ElevatedCount": 3, "HighCount": 5 }
    },
    // Risk appetite (5.3): a score at or above a threshold gets that
    // decision. Owned by the business, not by the rules above.
    "Decision": { "ChallengeAt": 40, "BlockAt": 80 }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
