{
  // The doc's "load balancer" in front of the payment service (ch.2 HLD).
  // Clients only ever know this one address; which service and which
  // instance answers is the Gateway's business.
  "ReverseProxy": {
    "Routes": {
      // Public URL shape is resource-based (/api/payments/...), and the path
      // is forwarded unchanged — no prefix rewriting to keep in your head.
      "payments": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**rest}" }
      }
    },
    "Clusters": {
      "payment": {
        // Spread requests evenly over instances that are currently healthy.
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          // Active: the Gateway polls each instance's readiness probe from
          // Module 1.5 and stops routing to one that fails — exactly the
          // ALB target-group health check, done in-process.
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          // What to do when EVERY instance is unhealthy (DESIGN decision 18):
          //   HealthyAndUnknown  fail closed: the Gateway answers 503 itself.
          //   HealthyOrPanic     fail open: route to all instances anyway —
          //                      what AWS ALB does. Chosen so a broken
          //                      health check can't take the whole service
          //                      offline; instances whose database is down
          //                      still fail fast on their own (503).
          // Set explicitly: this is a decision, not something to inherit
          // from a library default.
          "AvailableDestinationsPolicy": "HealthyOrPanic"
        },
        "Metadata": {
          // Two failed probes in a row (~10 s) before an instance is pulled.
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        // Two instances of the same service on different ports, so failover
        // can be seen locally. Both use the same payx_payments database.
        "Destinations": {
          "payment-1": { "Address": "http://localhost:7082/" },
          "payment-2": { "Address": "http://localhost:7092/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Logs each destination going healthy/unhealthy — the thing to watch.
      "Yarp.ReverseProxy.Health": "Information"
    }
  }
}
