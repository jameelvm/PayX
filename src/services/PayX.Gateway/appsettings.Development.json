{
  // Development only: what the test console (http://localhost:7080/console/)
  // needs on top of appsettings.json.
  "ReverseProxy": {
    "Routes": {
      // Card entry for the console. Tokenize only: the exact path, POST only,
      // so Vault's authorize-by-token endpoint (/api/vault/cards/{token}/…)
      // stays reachable by Payment alone. How a real checkout reaches Vault
      // (hosted fields, its own route) is decided in Phase 10.
      "vault-tokenize": {
        "ClusterId": "vault",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/vault/cards", "Methods": [ "POST" ] }
      }
    },
    "Clusters": {
      "vault": {
        "Destinations": {
          "vault-1": { "Address": "http://localhost:7084/" }
        }
      }
    }
  }
}
