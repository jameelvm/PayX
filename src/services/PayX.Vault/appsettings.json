{
  "ConnectionStrings": {
    // abortConnect=false: start even if Redis is down, and keep retrying;
    // readiness reports it meanwhile.
    "Redis": "localhost:6381,abortConnect=false"
  },
  "AWS": {
    // LocalStack. Remove on AWS: the SDK then uses the real endpoint and the
    // task role's credentials.
    "ServiceURL": "http://localhost:4568",
    "Region": "us-east-1"
  },
  "Vault": {
    // By alias, so code and config don't change when the key behind it does.
    "KmsKeyId": "alias/payx-card-vault",
    "TableName": "payx-card-vault",
    // How long a CVC waits for its first authorization. Checkout normally
    // pays within seconds of entering the card; after this, it's gone.
    "CvcTtl": "00:10:00"
  },
  "Psp": {
    // The PSP simulator locally; the provider's API in production.
    "BaseUrl": "http://localhost:7088/",
    "Timeout": "00:00:10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
